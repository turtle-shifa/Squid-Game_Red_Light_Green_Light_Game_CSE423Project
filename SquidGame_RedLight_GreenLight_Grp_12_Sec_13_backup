def draw_ground_plane(size=20, color=(0.2, 0.8, 0.2)):
    """Draws a large ground plane."""
    glColor3fv(color) # Set the color
    glBegin(GL_QUADS) # Begin drawing a quadrilateral
    glNormal3fv((0, 1, 0)) # Normal pointing upwards for lighting
    glVertex3f(-size, 0, -size) # Bottom-left corner
    glVertex3f(size, 0, -size)  # Bottom-right corner
    glVertex3f(size, 0, size)   # Top-right corner
    glVertex3f(-size, 0, size)  # Top-left corner
    glEnd() # End drawing the quadrilateral

def load_texture(filename):
    """Load a texture from file and return its ID"""
    try:
        img = Image.open(filename)
        img_data = np.array(list(img.getdata()), np.uint8)
        
        texture_id = glGenTextures(1)
        glBindTexture(GL_TEXTURE_2D, texture_id)
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR)
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR)
        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, img.size[0], img.size[1], 0, GL_RGB, GL_UNSIGNED_BYTE, img_data)
        
        return texture_id
    except Exception as e:
        print(f"Error loading texture {filename}: {e}")
        return None

def load_sound(filename):
    """Load a sound file and return its data"""
    try:
        wf = wave.open(filename, 'rb')
        return wf
    except Exception as e:
        print(f"Error loading sound {filename}: {e}")
        return None

def setup_lighting():
    """Set up advanced lighting system"""
    glEnable(GL_LIGHTING)
    glEnable(GL_LIGHT0)
    
    # Set up light position and properties
    glLightfv(GL_LIGHT0, GL_POSITION, LIGHT_POSITION)
    glLightfv(GL_LIGHT0, GL_AMBIENT, AMBIENT_LIGHT)
    glLightfv(GL_LIGHT0, GL_DIFFUSE, DIFFUSE_LIGHT)
    glLightfv(GL_LIGHT0, GL_SPECULAR, SPECULAR_LIGHT)
    
    # Enable material properties
    glEnable(GL_COLOR_MATERIAL)
    glColorMaterial(GL_FRONT, GL_AMBIENT_AND_DIFFUSE)

def create_particle(position, color=PARTICLE_COLOR):
    """Create a new particle"""
    velocity = (
        random.uniform(-1, 1),
        random.uniform(2, 5),
        random.uniform(-1, 1)
    )
    return Particle(position, velocity, color, random.uniform(1.0, 2.0))

def update_particles(dt):
    """Update all particles"""
    global PARTICLES
    
    # Create new particles if needed and doll is rotating
    if len(PARTICLES) < MAX_PARTICLES and is_rotating and random.random() < 0.3:
        PARTICLES.append(create_particle(DOLL_POSITION))
    
    # Update existing particles
    PARTICLES = [p for p in PARTICLES if p.update(dt)]

def draw_particles():
    """Draw all particles"""
    if not PARTICLES:
        return
        
    glDisable(GL_LIGHTING)
    glBegin(GL_POINTS)
    for particle in PARTICLES:
        glColor3fv(particle.color)
        glVertex3fv(particle.position)
    glEnd()
    glEnable(GL_LIGHTING)

def setup_camera():
    """Set up advanced camera system with smooth transitions"""
    global camera_transitioning, camera_transition_start
    
    current_time = time.time()
    if camera_transitioning and current_time - camera_transition_start < camera_transition_time:
        # Calculate transition progress
        progress = (current_time - camera_transition_start) / camera_transition_time
        progress = min(1.0, progress)
        
        # Get current and target camera parameters
        current_mode = CAMERA_MODES[current_camera_mode]
        
        # Interpolate position and target
        pos = tuple(
            current_mode['pos'][i] * progress
            for i in range(3)
        )
        target = tuple(
            current_mode['target'][i] * progress
            for i in range(3)
        )
    else:
        camera_transitioning = False
        # Use final camera parameters
        pos = CAMERA_MODES[current_camera_mode]['pos']
        target = CAMERA_MODES[current_camera_mode]['target']
    
    # Set up camera
    glMatrixMode(GL_PROJECTION)
    glLoadIdentity()
    gluPerspective(fovY, 1.25, 0.1, 2000)
    
    glMatrixMode(GL_MODELVIEW)
    glLoadIdentity()
    gluLookAt(pos[0], pos[1], pos[2],
              target[0], target[1], target[2],
              0, 1, 0)

def draw_advanced_environment():
