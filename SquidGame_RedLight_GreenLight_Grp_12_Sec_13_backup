        glBindTexture(GL_TEXTURE_2D, TEXTURES['ground'])
    else:
        glColor3f(0.2, 0.7, 0.2)  # Default green color
    
    glBegin(GL_QUADS)
    glTexCoord2f(0, 0) if TEXTURES_ENABLED else None
    glVertex3f(-PATH_WIDTH/2, 0, START_LINE_Z)
    glTexCoord2f(1, 0) if TEXTURES_ENABLED else None
    glVertex3f(PATH_WIDTH/2, 0, START_LINE_Z)
