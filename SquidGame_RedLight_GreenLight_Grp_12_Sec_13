    glTranslatef(0, DOLL_BODY_HEIGHT + DOLL_HEAD_RADIUS/2, 0)  # Position on top of body
    gluSphere(gluNewQuadric(), DOLL_HEAD_RADIUS, 24, 24)  # Draw sphere for head with more detail
